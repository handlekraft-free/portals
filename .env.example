# PostgreSQL connection string used by Drizzle and the runtime.
# Example (local): postgres://user:pass@localhost:5432/openportals
DATABASE_URL=

# Secret used to sign JWT auth tokens for portal users. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Threshold (number of crew members online) that triggers the "full crew" gamification event.
FULL_CREW_THRESHOLD=3

# Optional: port to bind. Defaults to 5000.
# PORT=5000
