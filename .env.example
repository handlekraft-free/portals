# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Drizzle and the runtime.
# Local example: postgres://postgres:postgres@localhost:5432/openportals
DATABASE_URL=

# Secret used to sign JWT auth tokens for portal users.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── Optional ────────────────────────────────────────────────────────────────

# Port to bind. Defaults to 5000.
# PORT=5000

# Where uploaded files (LMS, client portal, chat attachments) are stored.
# Defaults to ./data/uploads
# UPLOAD_DIR=./data/uploads

# Which portals are exposed in this deployment. Comma-separated list of:
#   employee, client, student, board
# Disabled portals are hidden from the login screen and their API routes are
# not mounted. The admin role is always enabled. Defaults to all four.
# Examples:
#   ENABLED_PORTALS=board                   # board-only deployment
#   ENABLED_PORTALS=employee,client         # services org without students
# ENABLED_PORTALS=employee,client,student,board

# Anthropic API key — required only if you use the AI advisor / kanban AI helpers.
# Either name works; AI_INTEGRATIONS_* takes precedence when both are set.
# ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Google OAuth — required only if you want Gmail/Calendar notifications in portals.
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
